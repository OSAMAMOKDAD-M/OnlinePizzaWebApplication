@model IEnumerable<Pizza>
@{
    ViewData["Title"] = "القائمة";
}

<h1 class="h3 mb-4">قائمة البيتزا</h1>

@foreach (var group in Model.GroupBy(p => p.Category?.Name ?? "أخرى"))
{
    <h2 class="h5 mt-4 mb-3 text-secondary">@group.Key</h2>
    <div class="row g-4">
        @foreach (var pizza in group)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card pizza-card h-100">
                    <img src="@(string.IsNullOrWhiteSpace(pizza.ImageUrl) ? "https://placehold.co/400x300?text=Pizza" : pizza.ImageUrl)" class="pizza-thumb card-img-top" alt="@pizza.Name" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@pizza.Name</h5>
                        <p class="card-text small text-muted flex-grow-1">@pizza.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@pizza.Price.ToString("0.##") ج.م</span>
                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="id" value="@pizza.PizzaId" />
                                <button type="submit" class="btn btn-brand btn-sm"><i class="bi bi-cart-plus"></i> أضف للسلة</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
