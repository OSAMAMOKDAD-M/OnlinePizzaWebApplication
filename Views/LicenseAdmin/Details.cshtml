@model LicenseKey
@{
    ViewData["Title"] = "تفاصيل الترخيص";
    var activations = ViewBag.Activations as List<LicenseActivation> ?? new List<LicenseActivation>();
}
<h1 class="h3 mb-4">تفاصيل الترخيص</h1>
<div class="card mb-3"><div class="card-body">
    <div class="row">
        <div class="col-md-6 mb-2"><strong>المفتاح:</strong> <span class="font-monospace">@Model.MaskedKey</span></div>
        <div class="col-md-6 mb-2"><strong>الحالة:</strong> @Model.Status</div>
        <div class="col-md-6 mb-2"><strong>تاريخ الإنشاء:</strong> @Model.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
        <div class="col-md-6 mb-2"><strong>تاريخ التفعيل:</strong> @(Model.ActivatedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "لم يُفعّل بعد")</div>
        <div class="col-md-6 mb-2"><strong>تاريخ الانتهاء:</strong> @(Model.ExpiresAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
        <div class="col-md-6 mb-2"><strong>حد الأجهزة:</strong> @Model.MaxDevices</div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="col-12"><strong>ملاحظات:</strong> @Model.Notes</div>
        }
    </div>
</div></div>

<h2 class="h5 mb-3">الأجهزة المفعّلة</h2>
<div class="card"><div class="table-responsive">
    <table class="table mb-0">
        <thead class="table-light"><tr><th>الجهاز</th><th>المعرّف</th><th>تاريخ التفعيل</th><th>آخر ظهور</th><th></th></tr></thead>
        <tbody>
        @if (activations.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">لا توجد أجهزة مفعّلة.</td></tr>
        }
        @foreach (var a in activations)
        {
            <tr>
                <td>@a.DeviceName</td>
                <td class="font-monospace small">@(a.DeviceId.Length > 16 ? a.DeviceId[..16] + "…" : a.DeviceId)</td>
                <td>@a.ActivatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td>@a.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form asp-action="RemoveDevice" method="post" onsubmit="return confirm('إلغاء تفعيل هذا الجهاز؟');">
                        <input type="hidden" name="id" value="@a.Id" />
                        <input type="hidden" name="licenseId" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-danger">إلغاء</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div></div>
<a asp-action="Index" class="btn btn-link mt-3">عودة</a>
