@model List<ShoppingCartItem>
@{
    ViewData["Title"] = "سلة التسوق";
    var total = (decimal)(ViewBag.Total ?? 0m);
}
<h1 class="h3 mb-4">سلة التسوق</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">سلة التسوق فارغة. <a asp-controller="Pizzas" asp-action="Index">تصفّح القائمة</a></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الصنف</th>
                        <th>الكمية</th>
                        <th>السعر</th>
                        <th>الإجمالي</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Pizza?.Name</td>
                            <td>@item.Amount</td>
                            <td>@item.Price.ToString("0.##")</td>
                            <td>@((item.Price * item.Amount).ToString("0.##"))</td>
                            <td>
                                <form asp-action="RemoveFromCart" method="post">
                                    <input type="hidden" name="id" value="@item.PizzaId" />
                                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-dash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">الإجمالي</td>
                        <td colspan="2">@total.ToString("0.##") ج.م</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="mt-3 text-start">
        <a asp-controller="Orders" asp-action="Checkout" class="btn btn-brand">إتمام الطلب</a>
    </div>
}
