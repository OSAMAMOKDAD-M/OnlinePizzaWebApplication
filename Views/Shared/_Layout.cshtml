@inject IRestaurantSettingsService RestaurantSettings
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var restaurant = await RestaurantSettings.GetAsync();
    var appName = restaurant.Name;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" integrity="sha384-PJsj/BLmeqQrpQrykMcJTP5No5W5+kZzWVKvFP9CTFa1Xe6iBg1PgqBFPzGZKBnR" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrWhiteSpace(restaurant.LogoUrl))
                    {
                        <img src="@restaurant.LogoUrl" alt="@appName" height="34" class="rounded" />
                    }
                    else
                    {
                        <i class="bi bi-pizza-fill fs-4"></i>
                    }
                    <span>@appName</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Pizzas" asp-action="Index">القائمة</a></li>
                        @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.Owner) || User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">الإدارة</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="ManagePizzas" asp-action="Index">إدارة البيتزا</a></li>
                                    <li><a class="dropdown-item" asp-controller="ManageCategories" asp-action="Index">إدارة التصنيفات</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">الطلبات</a></li>
                                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">الإعدادات</a></li>
                                    @if (User.IsInRole(Roles.SuperAdmin))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="LicenseAdmin" asp-action="Index">إدارة التراخيص</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="ShoppingCart" asp-action="Index">
                                <i class="bi bi-cart3"></i> السلة
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link">@User.Identity!.Name</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">تسجيل الخروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">دخول</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">تسجيل</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    @await Html.PartialAsync("_CopyrightFooter")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
